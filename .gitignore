# Donnees originales et pretraitees
data/raw/*
data/processed/*

# Conserver les dossiers dans Git
!data/raw/.gitkeep
!data/processed/.gitkeep

# Fichiers compiles
__pycache__/
*.py[cod]
*$py.class

# Environnements virtuels
venv/
.venv/
env/
ENV/

# Fichiers temporaires
*.tmp
*.bak
*.swp

.ipynb_checkpoints/

# MODELES ENTRAINES
*.pkl
*.joblib
*.pth
*.pt
*.h5
*.keras

# TESTS ET COUVERTURE
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# IDE ET EDITEURS
.vscode/
.idea/
*.sublime-workspace

# STREAMLIT
.streamlit/secrets.toml
.streamlit/credentials.toml

# VARIABLES D'ENVIRONNEMENT
.env
.env.*
!.env.example

# OUTILS DE QUALITE DU CODE
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# SYSTEME
.DS_Store
Thumbs.db
desktop.ini

# LOGS
*.log
